{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-gate-live",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/images/*"]},
  "d1_databases": [{"binding":"DB","database_name":"school-gate-db","database_id":"3b0ff910-81cb-456f-ba2b-6a99e6557f76","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"PHOTOS","bucket_name":"school-gate-photos"}]
}
